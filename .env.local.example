# ---------------------------------------------------------------------------
# icsmx-autob-webapp — variables de entorno
#
# Copiar a .env.local y completar. NUNCA versionar .env.local.
# En despliegue, estas variables se inyectan como secretos de Amplify.
# ---------------------------------------------------------------------------

# --- Identidad: Okta via @auth0/nextjs-auth0 -------------------------------
# Dominio del tenant de Okta, sin protocolo.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Secreto de cifrado de la cookie de sesion.
# Generar con:  openssl rand -hex 32
AUTH_SECRET=

# URL base de la aplicacion. Debe coincidir con la URL de callback
# registrada en Okta.
APP_BASE_URL=http://localhost:3000

# --- EAS: resolucion de roles ----------------------------------------------
# Si EAS no responde, la aplicacion falla de forma explicita.
# No hay fallback silencioso: usar ENABLE_DEV_TOOLS=MOCK_USERS para
# trabajar sin EAS.
EAS_PROFILE_URL=
EAS_API_KEY=

# --- AWS --------------------------------------------------------------------
AWS_REGION=us-east-1

# Tabla unica de DynamoDB. La crea `npx ampx sandbox`.
AUTOB_TABLE_NAME=

# Bucket privado de fotografias y comprobantes.
AUTOB_MEDIA_BUCKET=

# --- CloudFront: fotografias con URL firmada -------------------------------
# Las URLs se firman en SSR en cada peticion.
# Nunca se persisten ni se generan dentro de un bloque "use cache".
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=

# Llave privada en PEM, con los saltos de linea escapados como \n.
CLOUDFRONT_PRIVATE_KEY=

# --- CES: correo (Church Email Service) -----------------------------------
# El correo transaccional NO sale por SES. CES es un servicio REST externo:
# se le hace POST con un JSON y autenticacion basica. No es infraestructura de
# AWS, asi que no aparece en amplify/ — solo son credenciales en tiempo de
# ejecucion, que consume el procesador del outbox.
#
# CES aun no esta aprobado para este proyecto (riesgo R17). Estas variables se
# cablean en la Etapa 10, cuando exista el procesador del outbox.
CES_URL=
CES_USER=
CES_PASSWORD=

# Direccion remitente que viaja en el cuerpo del mensaje.
CES_FROM_ADDRESS=

# --- Herramientas de desarrollo --------------------------------------------
# OFF                 solo servicios reales. UNICO valor admisible en produccion
# MOCK_USERS          roles simulados, para trabajar sin EAS
# FULL                simulacion e impersonacion de rol
#
# La aplicacion LANZA UN ERROR DE ARRANQUE si NODE_ENV=production
# y este valor no es OFF.
ENABLE_DEV_TOOLS=MOCK_USERS

# Roles simulados que devuelve src/lib/auth/eas.ts cuando ENABLE_DEV_TOOLS
# no es OFF. Lista separada por comas, de agent_files/permission-matrix.md.
# Sin esta variable, se simula un solo ADMINISTRADOR.
DEV_TOOLS_MOCK_ROLES=ADMINISTRADOR

# ---------------------------------------------------------------------------
# Fuera de este archivo, en variables de entorno del sistema:
#
#   NODE_AUTH_TOKEN       token del Artifactory privado (.npmrc).
#                         Sin el, `npm install` falla con 401.
#
#   NODE_EXTRA_CA_CERTS   ruta al PEM del CA corporativo, en maquinas con
#                         inspeccion TLS. Sin el, npm, ampx y los SDK de AWS
#                         fallan con UNABLE_TO_VERIFY_LEAF_SIGNATURE.
#                         Ver agent_files/desafios-implementacion.md, seccion 1.
# ---------------------------------------------------------------------------
