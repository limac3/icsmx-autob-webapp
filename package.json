    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "aws-cdk-lib": "^2.268.0",
    "axe-core": "^4.13.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.12",
    "typescript": "6.0.3"
